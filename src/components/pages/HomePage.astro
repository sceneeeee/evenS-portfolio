---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../ProjectCard.astro';
import { profile } from '../../data/profile';
import { dictionaries, localePath, type Locale } from '../../i18n';
import { localizedProjects } from '../../lib/projects';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = dictionaries[locale].home;
const projects = await localizedProjects(locale);
---
<BaseLayout title={t.title} description={t.description} locale={locale}>
  <div class="container">
    <section class="home-hero" aria-labelledby="intro-title">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow"><span class="small-cross" aria-hidden="true">+</span> {t.eyebrow}</p>
        <h1 id="intro-title">{t.heading[0]}<br /><span>{t.heading[1]}</span></h1>
        <p class="hero-intro">{t.introBefore}<strong>evenS</strong>{t.introAfter}</p>
        <div class="hero-actions"><a class="button" href="#selected-work">{t.explore} <span aria-hidden="true">↓</span></a><a class="text-link" href={profile.github}>GitHub <span aria-hidden="true">↗</span></a><span class="availability-note">{t.cv}</span></div>
      </div>
      <aside class="hero-focus" aria-label={t.focusLabel}>
        <p class="eyebrow">{t.focus}</p>
        <ol>{t.focuses.map((focus, i) => <li><span>{String(i + 1).padStart(2, '0')}</span> {focus}</li>)}</ol>
        <p class="focus-note">{t.focusNotes.map((line, i) => <>{i > 0 && <br />}{line}</>)}</p>
      </aside>
    </section>
    <section id="selected-work" class="section-block" aria-labelledby="selected-title">
      <div class="section-heading"><div><p class="eyebrow">{t.selected}</p><h2 id="selected-title">{t.selectedTitle}</h2></div><a class="text-link" href={localePath('/projects/', locale)}>{t.all} <span aria-hidden="true">↗</span></a></div>
      <div class="project-grid">{projects.map((project, i) => <ProjectCard project={project} featured={i === 0} />)}</div>
    </section>
    <section class="section-block practice-section" aria-labelledby="practice-title">
      <div class="section-heading"><div><p class="eyebrow">{t.practice}</p><h2 id="practice-title">{t.practiceTitle}</h2></div></div>
      <div class="practice-grid">{t.practices.map(practice => <article><span class="practice-index">{practice.label}</span><h3>{practice.title}</h3><p>{practice.text}</p><a href={localePath(`/projects/etpnav-mid360/#${practice.anchor}`, locale)}>{practice.link} <span aria-hidden="true">↗</span></a></article>)}</div>
    </section>
    <section id="background" class="background-section section-block" aria-labelledby="background-title">
      <div><p class="eyebrow">{t.background}</p><h2 id="background-title">{t.backgroundTitle[0]}<br />{t.backgroundTitle[1]}</h2></div>
      <div>{t.backgroundText.map(text => <p>{text}</p>)}<div class="development-note"><span class="eyebrow">{t.development}</span><p>{t.developmentText}</p></div></div>
    </section>
    <section class="closing-section" aria-labelledby="closing-title"><div><p class="eyebrow">{t.continue}</p><h2 id="closing-title">{t.closing}</h2></div><a class="button" href={localePath('/projects/etpnav-mid360/', locale)}>ETPNav × MID360 <span aria-hidden="true">↗</span></a></section>
  </div>
</BaseLayout>
